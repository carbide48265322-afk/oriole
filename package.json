{
  "name": "oriole",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "dev:electron": "concurrently \"pnpm dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "build:electron": "pnpm build && electron-builder",
    "build:electron:mac": "pnpm build && electron-builder --mac",
    "build:electron:win": "pnpm build && electron-builder --win",
    "build:electron:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/provider": "^3.0.8",
    "@ant-design/icons": "^6.1.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.98.0",
    "@tanstack/react-virtual": "^3.13.23",
    "ai": "^6.0.158",
    "antd": "^6.3.5",
    "next": "^16.2.3",
    "qiankun": "^2.10.16",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-pdf": "^10.4.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "video.js": "^8.23.7",
    "wavesurfer.js": "^7.12.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.2",
    "playwright": "^1.59.1",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}